# ==============================================================================
# Thelix AI Backend Environment Configuration Template
# ==============================================================================

# Application & Environment
ENVIRONMENT=development # development | pilot | production
DEBUG=false
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
INTERNAL_SERVICE_TOKEN=replace-with-internal-service-hmac-token

# Database Connection (SQLite for local dev, PostgreSQL for staging/prod)
DATABASE_URL=sqlite:///./thelix.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/thelix_ai

# Supabase Authentication & Persistence
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
SUPABASE_JWT_SECRET=replace-with-your-supabase-jwt-secret

# Network Boundaries & CORS (Wildcard prohibited in pilot/production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# LLM Provider Configuration
LLM_PROVIDER=gemini # gemini | mock
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=20.0
LLM_MAX_RETRIES=1

# Threat Intelligence APIs (Optional - Fallbacks to deterministic static heuristics)
VIRUSTOTAL_API_KEY=
SAFE_BROWSING_API_KEY=
FACT_CHECK_API_KEY=

# Isolated Sandbox Inspection Controls (Keep false until genuine OS/container isolation exists)
SAFE_LOCAL_SANDBOX_ENABLED=false
SANDBOX_TIMEOUT_SECONDS=10.0
SANDBOX_MAX_REDIRECT_HOPS=5
SANDBOX_MAX_BODY_BYTES=5242880

# Local AI / Gemma Settings (Optional)
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL_VERSION=gemma-2b-v3

# Controlled Pilot Controls
PILOT_MODE_ENABLED=false
PILOT_ALLOWED_EMAILS=
PILOT_MAX_SCANS_PER_USER_PER_DAY=50

# Privacy, Data Retention, & Lifecycle (in days)
SCAN_RETENTION_DAYS=30
ARTIFACT_RETENTION_DAYS=7
AUDIT_LOG_RETENTION_DAYS=90
REDACT_EXTRACTED_CONTENT_IN_STORAGE=true
STUCK_SCAN_TIMEOUT_MINUTES=15

# Upload, OCR, & Distributed Rate Limits
MAX_UPLOAD_SIZE_BYTES=10485760 # 10MB
OCR_REQUIRED=false # Enforces Tesseract binary availability in readiness probe

RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE=memory # memory (local/test) | redis (staging/production/multi-worker)
REDIS_URL=redis://localhost:6379/0 # Required when RATE_LIMIT_STORE=redis
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30

# Background Scan Worker Daemon Controls
WORKER_POLL_INTERVAL_SECONDS=2.0
WORKER_LEASE_SECONDS=300

# Integration Test Targets (Must point to authorized disposable test instances only)
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/thelix_disposable_test
# TEST_REDIS_URL=redis://localhost:6379/15


